/* Includes ------------------------------------------------------------------*/
#include "adc.h"

/* ADC句柄定义 */
ADC_HandleTypeDef hadc1;
DMA_HandleTypeDef hdma_adc1;

// 用于存储 ADC 多通道 DMA 采集的原始值
uint32_t ADC_RawValue[ADC_ChannelIndexMax];

/* ADC1初始化函数 */
void MX_ADC1_Init(void)
{
    ADC_ChannelConfTypeDef sConfig = {0};

    /* 配置ADC1参数 */
    hadc1.Instance = ADC1;
    hadc1.Init.ScanConvMode = ADC_SCAN_ENABLE;          // 启用扫描模式
    hadc1.Init.ContinuousConvMode = ENABLE;             // 连续转换模式
    hadc1.Init.DiscontinuousConvMode = DISABLE;         // 禁用间断模式
    hadc1.Init.ExternalTrigConv = ADC_SOFTWARE_START;   // 软件触发
    hadc1.Init.DataAlign = ADC_DATAALIGN_RIGHT;         // 数据右对齐
    hadc1.Init.NbrOfConversion = 6;                     // 6个转换通道
    
    if (HAL_ADC_Init(&hadc1) != HAL_OK)
    {
        Error_Handler();
    }

    /* 配置6个ADC通道 */
    // 通道4 (PA4) - 对应ADC1_CH04_PA4，用于左电感传感器
    sConfig.Channel = ADC_CHANNEL_4;
    sConfig.Rank = ADC_REGULAR_RANK_1;
    sConfig.SamplingTime = ADC_SAMPLETIME_239CYCLES_5;  // 长采样时间，提高精度
    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
    {
        Error_Handler();
    }

    // 通道15 (PC5) - 对应ADC1_CH15_PC5，用于右电感传感器
    sConfig.Channel = ADC_CHANNEL_15;
    sConfig.Rank = ADC_REGULAR_RANK_2;
    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
    {
        Error_Handler();
    }

    // 通道5 (PA5) - 第3个模拟输入
    sConfig.Channel = ADC_CHANNEL_5;
    sConfig.Rank = ADC_REGULAR_RANK_3;
    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
    {
        Error_Handler();
    }

    // 通道10 (PC0) - 第4个模拟输入
    sConfig.Channel = ADC_CHANNEL_10;
    sConfig.Rank = ADC_REGULAR_RANK_4;
    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
    {
        Error_Handler();
    }

    // 通道11 (PC1) - 第5个模拟输入
    sConfig.Channel = ADC_CHANNEL_11;
    sConfig.Rank = ADC_REGULAR_RANK_5;
    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
    {
        Error_Handler();
    }

    // 通道12 (PC2) - 第6个模拟输入
    sConfig.Channel = ADC_CHANNEL_12;
    sConfig.Rank = ADC_REGULAR_RANK_6;
    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
    {
        Error_Handler();
    }
}

/* ADC1的硬件资源初始化 */
void HAL_ADC_MspInit(ADC_HandleTypeDef* adcHandle)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};
    
    if(adcHandle->Instance==ADC1)
    {
        /* 使能ADC1时钟 */
        __HAL_RCC_ADC1_CLK_ENABLE();

        /* 使能GPIO时钟 */
        __HAL_RCC_GPIOC_CLK_ENABLE();
        __HAL_RCC_GPIOA_CLK_ENABLE();
        
        /**ADC1 GPIO配置
         * PC0 -> ADC1_IN10
         * PC1 -> ADC1_IN11
         * PC2 -> ADC1_IN12
         * PA4 -> ADC1_IN4 (左电感)
         * PA5 -> ADC1_IN5
         * PC5 -> ADC1_IN15 (右电感)
         */
        GPIO_InitStruct.Pin = GPIO_PIN_0|GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_5;
        GPIO_InitStruct.Mode = GPIO_MODE_ANALOG;  // 模拟输入模式
        HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

        GPIO_InitStruct.Pin = GPIO_PIN_4|GPIO_PIN_5;
        GPIO_InitStruct.Mode = GPIO_MODE_ANALOG;
        HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);

        /* 配置ADC1的DMA */
        hdma_adc1.Instance = DMA1_Channel1;
        hdma_adc1.Init.Direction = DMA_PERIPH_TO_MEMORY;        // 外设到内存
        hdma_adc1.Init.PeriphInc = DMA_PINC_DISABLE;            // 外设地址不增加
        hdma_adc1.Init.MemInc = DMA_MINC_ENABLE;                // 内存地址递增
        hdma_adc1.Init.PeriphDataAlignment = DMA_PDATAALIGN_HALFWORD;  // 半字对齐
        hdma_adc1.Init.MemDataAlignment = DMA_MDATAALIGN_HALFWORD;     // 半字对齐
        hdma_adc1.Init.Mode = DMA_CIRCULAR;                     // 循环模式
        hdma_adc1.Init.Priority = DMA_PRIORITY_LOW;             // 低优先级
        if (HAL_DMA_Init(&hdma_adc1) != HAL_OK)
        {
            Error_Handler();
        }

        /* 将DMA与ADC关联 */
        __HAL_LINKDMA(adcHandle, DMA_Handle, hdma_adc1);
    }
}

/* ADC1的硬件资源反初始化 */
void HAL_ADC_MspDeInit(ADC_HandleTypeDef* adcHandle)
{
    if(adcHandle->Instance==ADC1)
    {
        /* 关闭外设时钟 */
        __HAL_RCC_ADC1_CLK_DISABLE();

        /* 反初始化GPIO */
        HAL_GPIO_DeInit(GPIOC, GPIO_PIN_0|GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_5);
        HAL_GPIO_DeInit(GPIOA, GPIO_PIN_4|GPIO_PIN_5);

        /* 反初始化DMA */
        HAL_DMA_DeInit(adcHandle->DMA_Handle);
    }
}

/* 用户自定义函数 */
/**
  * @brief  初始化ADC采集
  * @param  NULL
  * @retval NULL
  */
void ADC_Init(void)
{
    // 启动ADC校准
    HAL_ADCEx_Calibration_Start(&hadc1);

    HAL_Delay(500);  // 等待稳定

    // 启动DMA模式的ADC转换
    HAL_ADC_Start_DMA(&hadc1, (uint32_t *)ADC_RawValue, ADC_ChannelIndexMax);
}

/**
  * @brief  获取指定ADC通道的值
  * @param  Channel 通道枚举
  * @retval 通道的AD值
  */
uint16_t ADC_GetValue_Channel(ADC_Channel_enum Channel)
{
    if(Channel >= ADC_ChannelIndexMax)
    {
        return 0;
    }
    
    return ADC_RawValue[Channel];
}


/*
 * ADC配置分析：
 * 
 * 1. 扫描模式 (ADC_SCAN_ENABLE):
 *    - 依次转换多个通道
 *    - 适用于多传感器数据采集
 * 
 * 2. 连续模式 (ENABLE):
 *    - 不断进行ADC转换
 *    - 提供实时传感器数据
 * 
 * 3. DMA传输 (CIRCULAR模式):
 *    - 自动将转换结果存入数组
 *    - 避免CPU频繁读取ADC寄存器
 *    - 提高系统效率
 */

/*
 * ADC通道分配：
 * - ADC1_CH04_PA4 -> 左电感传感器
 * - ADC1_CH15_PC5 -> 右电感传感器
 * - ADC1_CH05_PA5 -> 预留通道
 * - ADC1_CH10_PC0 -> 预留通道
 * - ADC1_CH11_PC1 -> 预留通道
 * - ADC1_CH12_PC2 -> 预留通道
 * 通过差值算法 (AD_Left - AD_Right) 实现路径跟踪
 */




