/* USER CODE END Header */
#include "main.h"
#include "adc.h"
#include "dma.h"
#include "gpio.h"
#include "headfiles.h"
#include "tim.h"
#include "usart.h"

/* 舵机PWM参数定义 */
#define Steer_PWM_Center 795                          // 舵机中值   调低偏右
#define Steer_PWM_Limit_Lift (Steer_PWM_Center - 60)  // 舵机左转限幅
#define Steer_PWM_Limit_Right (Steer_PWM_Center + 60) // 舵机右转限幅

/* 全局变量定义 */
int16_t AD_Left, AD_Right;            // 左右电感的ADC值
float Dir_Err;                        // 方向偏差
int16_t Dir_Output;                   // 方向输出值
uint16_t SteerPWM = Steer_PWM_Center; // 舵机PWM输出值
void SystemClock_Config(void);

// PD与差速变量
float Dir_Err_Wheel = 0;
float Dir_Err_Wheel_Limit_Low=-400;     //差速限幅
float Dir_Err_Wheel_Limit_High=400;
float Kp, Kp_s, Kp_t_, Kd;
int16_t fliter_Buf_L[3] = {0, 0, 0};
int16_t fliter_Buf_R[3] = {0, 0, 0};
int16_t Kd_Change;
float Err_Tmp[2]={0,0};

// 左电机驱动变量
int16_t Wheel_Left_Speed;   // 驱动电机速度期望
int16_t Std_Speed;          //基准速度 
uint16_t Wheel_Left_PWM = 0;         // 驱动电机PWM输出值
uint8_t Wheel_Left_IO = RESET;       // 驱动电机IO口电平

// 右电机驱动变量
int16_t Wheel_Right_Speed;      		// 驱动电机速度期望
uint16_t Wheel_Right_PWM = 0;   		// 驱动电机PWM输出值
uint8_t Wheel_Right_IO = RESET; 		// 驱动电机IO口电平

// 拨码开关状态缓存
static uint8_t last_switch_count = 0xFF;  // 初始化为无效状态
static uint8_t current_switch_count = 0;

/**
 * @brief 更新拨码开关参数 - 基于开关打开数量
 * @retval 是否参数发生了变化
 */
uint8_t UpdateSwitchParameters(void) {
    // 读取开关状态
    Switch_GetCode();
    
    // 获取打开的开关数量
    uint8_t switch_count = 0;
    switch_count += Switch_GetState_Index(Switch_Index_1);
    switch_count += Switch_GetState_Index(Switch_Index_2);
    switch_count += Switch_GetState_Index(Switch_Index_3);
    switch_count += Switch_GetState_Index(Switch_Index_4);
    
    // 或者根据您的具体实现，可能是检测到的开关数量
    // 如果Switch_GetState_Index返回的是开关的编码值
    current_switch_count = switch_count;
    
    // 检查状态是否发生变化
    if (current_switch_count == last_switch_count) {
        return 0; // 没有变化
    }
    
    last_switch_count = current_switch_count;
    
    // 根据开关数量设置参数
    // 假设：0个开关打开、1个开关打开、2个开关打开等对应不同的模式
    switch(current_switch_count) {
        case 0: // 可能是所有开关都打开的情况（根据实际逻辑调整）
            Std_Speed = 300;
            Kp_s = 0.1;
            Kp_t_ = 0.50;
            Kd = 0.2;
            printf("Mode 0: Speed=300, Kp_s=0.1, Kp_t_=0.50, Kd=0.2\r\n");
            break;
        case 1: // 一个开关打开
            Std_Speed = 300;
            Kp_s = 0.1;
            Kp_t_ = 0.50;
            Kd = 0.2;
            printf("Mode 1: Speed=300, Kp_s=0.1, Kp_t_=0.50, Kd=0.2\r\n");
            break;
        case 2: // 两个开关打开
            Std_Speed = 500;
            Kp_s = 0.1;
            Kp_t_ = 0.52;
            Kd = 0.2;
            printf("Mode 2: Speed=500, Kp_s=0.1, Kp_t_=0.52, Kd=0.2\r\n");
            break;
        case 3: // 三个开关打开
            Std_Speed = 1000;
            Kp_s = 0.11;
            Kp_t_ = 0.55;
            Kd = 0.22;
            printf("Mode 3: Speed=1000, Kp_s=0.11, Kp_t_=0.55, Kd=0.22\r\n");
            break;
        case 4: // 四个开关打开
            Std_Speed = 1000;
            Kp_s = 0.11;
            Kp_t_ = 0.52;
            Kd = 0.2;
            printf("Mode 4: Speed=1000, Kp_s=0.11, Kp_t_=0.52, Kd=0.2\r\n");
            break;
        default:
            // 保持当前参数
            printf("Unknown mode: %d switches\r\n", current_switch_count);
            break;
    }
    
    return 1; // 参数已更新
}

/**
 * @brief 另一种可能的拨码开关处理方式 - 基于二进制编码
 */
uint8_t UpdateSwitchParametersBinary(void) {
    // 读取开关状态，将其作为二进制数处理
    Switch_GetCode();
    
    uint8_t bit1 = Switch_GetState_Index(Switch_Index_1);
    uint8_t bit2 = Switch_GetState_Index(Switch_Index_2);
    uint8_t bit3 = Switch_GetState_Index(Switch_Index_3);
    uint8_t bit4 = Switch_GetState_Index(Switch_Index_4);
    
    // 假设每个开关返回0或1，组合成4位二进制数
    uint8_t switch_code = (bit4 << 3) | (bit3 << 2) | (bit2 << 1) | (bit1 << 0);
    
    if (switch_code == last_switch_count) {
        return 0; // 没有变化
    }
    
    last_switch_count = switch_code;
    
    // 根据二进制编码设置参数
    switch(switch_code) {
        case 0b0001: // 仅开关1激活 (0x01)
            Std_Speed = 300;
            Kp_s = 0.1;
            Kp_t_ = 0.50;
            Kd = 0.2;
            printf("Mode 0x01: Speed=300, Kp_s=0.1, Kp_t_=0.50, Kd=0.2\r\n");
            break;
        case 0b0010: // 仅开关2激活 (0x02)
            Std_Speed = 500;
            Kp_s = 0.1;
            Kp_t_ = 0.52;
            Kd = 0.2;
            printf("Mode 0x02: Speed=500, Kp_s=0.1, Kp_t_=0.52, Kd=0.2\r\n");
            break;
        case 0b0100: // 仅开关3激活 (0x04)
            Std_Speed = 1000;
            Kp_s = 0.11;
            Kp_t_ = 0.55;
            Kd = 0.22;
            printf("Mode 0x04: Speed=1000, Kp_s=0.11, Kp_t_=0.55, Kd=0.22\r\n");
            break;
        case 0b1000: // 仅开关4激活 (0x08)
            Std_Speed = 1000;
            Kp_s = 0.11;
            Kp_t_ = 0.52;
            Kd = 0.2;
            printf("Mode 0x08: Speed=1000, Kp_s=0.11, Kp_t_=0.52, Kd=0.2\r\n");
            break;
        default:
            printf("Current switch code: 0x%02X\r\n", switch_code);
            break;
    }
    
    return 1; // 参数已更新
}

/**
 * @brief 调试函数：输出当前开关状态
 */
void DebugSwitchStatus(void) {
    static uint32_t last_debug_time = 0;
    if (HAL_GetTick() - last_debug_time > 1000) { // 每秒输出一次
        Switch_GetCode();
        uint8_t a1 = Switch_GetState_Index(Switch_Index_1);
        uint8_t a2 = Switch_GetState_Index(Switch_Index_2);
        uint8_t a3 = Switch_GetState_Index(Switch_Index_3);
        uint8_t a4 = Switch_GetState_Index(Switch_Index_4);
        
        printf("Switch states: SW1=%d, SW2=%d, SW3=%d, SW4=%d\r\n", a1, a2, a3, a4);
        
        // 计算开关数量
        uint8_t count = a1 + a2 + a3 + a4;
        printf("Active switches count: %d\r\n", count);
        
        // 计算二进制编码
        uint8_t code = (a4 << 3) | (a3 << 2) | (a2 << 1) | (a1 << 0);
        printf("Binary code: 0x%02X\r\n", code);
        
        last_debug_time = HAL_GetTick();
    }
}

int main(void) {
  HAL_Init(); // 初始化HAL库
  SystemClock_Config();

  // 初始化所有外设
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART1_UART_Init();
  MX_USART3_UART_Init();
  MX_TIM3_Init();
  MX_TIM5_Init();
  MX_TIM4_Init();
  MX_TIM6_Init();
  MX_TIM2_Init();
  MX_TIM8_Init();
  MX_TIM1_Init();
  MX_ADC1_Init();

  // 用户初始化
  PWM_Init(); // PWM初始化
  RC_Init();  // 遥控接收初始化
  ADC_Init(); // ADC初始化

  // 初始化参数
  Std_Speed = 300;
  Kp_s = 0.1;
  Kp_t_ = 0.50;
  Kd = 0.2;
  last_switch_count = 0xFF; // 强制第一次循环更新参数

  while (1) {
    // 1. 读取左右电感值并滤波
    int16_t raw_adc_left = ADC_GetValue_Channel(ADC1_CH04_PA4);
    int16_t raw_adc_right = ADC_GetValue_Channel(ADC1_CH15_PC5);
    
    // 更新滤波缓冲区
    static uint8_t filter_index = 0;
    fliter_Buf_L[filter_index] = raw_adc_left;
    fliter_Buf_R[filter_index] = raw_adc_right;
    filter_index = (filter_index + 1) % 3;
    
    // 计算平均值
    int32_t sum_l = 0, sum_r = 0;
    for(int i = 0; i < 3; i++) {
        sum_l += fliter_Buf_L[i];
        sum_r += fliter_Buf_R[i];
    }
    AD_Left = (int16_t)(sum_l / 3);
    AD_Right = (int16_t)(sum_r / 3);

    // 2. 更新拨码开关参数（仅在状态改变时更新）
    uint8_t params_changed = UpdateSwitchParametersBinary(); // 使用二进制编码方式
    
    // 如果参数发生变化，可以执行特定的初始化操作
    if(params_changed) {
        // 重置一些变量或执行参数切换相关的初始化
        Err_Tmp[0] = Err_Tmp[1] = 0;
    }

    // 3. 调试输出开关状态
    DebugSwitchStatus();

    Dir_Err = AD_Left - AD_Right;

    /*分段式P*/
    if (Dir_Err > 800 || Dir_Err < -800) { // 转弯分段
      Kp = Kp_t_;   
    } else {     // 直行分段
      Kp = Kp_s; // 直行P参数
    }

    /*微分修正D */
    Err_Tmp[1] = Err_Tmp[0];
    Err_Tmp[0] = Dir_Err;
    Kd_Change = Err_Tmp[0] - Err_Tmp[1];
    
    Dir_Output = Steer_PWM_Center + Dir_Err * Kp - Kd_Change * Kd; // 舵机PD修正
    SteerPWM = Data_Limit(Dir_Output, Steer_PWM_Limit_Lift, Steer_PWM_Limit_Right);
    
    Dir_Err_Wheel = (Dir_Output - Steer_PWM_Center) * Kp - Kd_Change * Kd * 5; // 差速PD修正
    Dir_Err_Wheel = Data_Limit(Dir_Err_Wheel, Dir_Err_Wheel_Limit_Low, Dir_Err_Wheel_Limit_High);

    // 4. 电机控制逻辑
    if (Switch_EN_ON) {
      Wheel_Left_Speed = Std_Speed;                     // 设定速度
      Wheel_Right_Speed = (int)Wheel_Left_Speed * 1.45; // 1.45
      Wheel_Right_Speed += (int)(Dir_Err_Wheel);  // 差速
      Wheel_Left_Speed -= (int)(Dir_Err_Wheel);
      HAL_GPIO_WritePin(Enable_IO_GPIO_Port, Enable_IO_Pin, GPIO_PIN_SET);
    } else {
      Wheel_Left_Speed = 0; // 停止
      Wheel_Right_Speed = 0;
      HAL_GPIO_WritePin(Enable_IO_GPIO_Port, Enable_IO_Pin, GPIO_PIN_RESET);
    }

    // 5. 速度限幅
    Wheel_Left_Speed = Data_Limit(Wheel_Left_Speed, -4000, 4000);
    Wheel_Right_Speed = Data_Limit(Wheel_Right_Speed, -4000, 4000);

    // 6. 左电机PWM和方向控制
    if (Wheel_Left_Speed >= 0) {
      Wheel_Left_PWM = Wheel_Left_Speed;
      Wheel_Left_IO = GPIO_PIN_RESET;
    } else {
      Wheel_Left_PWM = 4800 + Wheel_Left_Speed;
      Wheel_Left_IO = GPIO_PIN_SET;
    }

    // 7. 右电机PWM和方向控制
    if (Wheel_Right_Speed >= 0) {
      Wheel_Right_PWM = Wheel_Right_Speed;
      Wheel_Right_IO = GPIO_PIN_RESET;
    } else {
      Wheel_Right_PWM = 4800 + Wheel_Right_Speed;
      Wheel_Right_IO = GPIO_PIN_SET;
    }

    // 8. 输出控制信号
    PWM_SetDuty(PWM_TIM3_CH3_B0, SteerPWM);
    PWM_SetDuty(PWM_TIM4_CH2_B7, Wheel_Left_PWM);  // 左电机PWM
    PWM_SetDuty(PWM_TIM4_CH1_B6, Wheel_Right_PWM); // 右电机PWM
    HAL_GPIO_WritePin(Wheel_Left_IO_GPIO_Port, Wheel_Left_IO_Pin, Wheel_Left_IO);
    HAL_GPIO_WritePin(Wheel_Right_IO_GPIO_Port, Wheel_Right_IO_Pin, Wheel_Right_IO);

    // 9. LED状态指示
    Switch_GetCode(); // 读取拨码开关状态
    PWM_SetDuty(PWM_TIM1_CH4_A11, Switch_GetState_Index(Switch_Index_1) * PWM_BreathDuty());
    HAL_GPIO_WritePin(LED_2_GPIO_Port, LED_2_Pin, Switch_GetState_Index(Switch_Index_2));
    HAL_GPIO_WritePin(LED_3_GPIO_Port, LED_3_Pin, Switch_GetState_Index(Switch_Index_3));
    HAL_GPIO_WritePin(LED_4_GPIO_Port, LED_4_Pin, Switch_GetState_Index(Switch_Index_4));

    // 10. 串口调试输出
    VOFA_JustFloat(&huart_DBG);

    HAL_Delay(8); // 10ms循环周期
  }
}






/**
 * @brief 系统时钟配置 - 72MHz
 */
void SystemClock_Config(void) {
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};
  RCC_PeriphCLKInitTypeDef PeriphClkInit = {0};

  // 配置HSE和PLL
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState = RCC_HSE_ON;
  RCC_OscInitStruct.HSEPredivValue = RCC_HSE_PREDIV_DIV1;
  RCC_OscInitStruct.HSIState = RCC_HSI_ON;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLMUL = RCC_PLL_MUL9; // 8MHz * 9 = 72MHz
  HAL_RCC_OscConfig(&RCC_OscInitStruct);

  // 配置系统时钟
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK |
                                RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV2; // 36MHz
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1; // 72MHz
  HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_2);

  // ADC时钟配置
  PeriphClkInit.PeriphClockSelection = RCC_PERIPHCLK_ADC;
  PeriphClkInit.AdcClockSelection = RCC_ADCPCLK2_DIV6; // 6MHz
  HAL_RCCEx_PeriphCLKConfig(&PeriphClkInit);
}

/**
 * @brief 定时器中断回调函数
 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
  if (htim->Instance == TIM7) {
    HAL_IncTick(); // 增加系统滴答计数
  }
}

/**
 * @brief 错误处理函数
 */
void Error_Handler(void) {
  __disable_irq();
  while (1) {
    // 错误发生时的处理
  }
}
